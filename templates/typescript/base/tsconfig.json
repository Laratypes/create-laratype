{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2020",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "lib": ["ES2022"],
    "sourceMap": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "moduleResolution": "node",
    "paths": {
      "laratype": ["../../src"],
      "@laratype/*": ["../../packages/*/src"]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": [
    "./config/*",
    "./environment.d.ts",
    "./src/*/*.d.ts",
    "./src/*/*.ts"
  ],
  "exclude": ["node_modules", "<node_internals>/**"]
}
